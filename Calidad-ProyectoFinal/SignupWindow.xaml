<Window x:Class="Calidad_ProyectoFinal.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign up - Firebase Auth App" WindowStartupLocation="CenterOwner" Style="{StaticResource Dialog}" Loaded="Window_Loaded" Closing="Window_Closing">
    <StackPanel Margin="40">
        <Grid>
            <TextBlock Text="Sing-Up" Style="{StaticResource Title}"/>
            <Button Style="{StaticResource demoButton}" Click="Demo_Click">Demo</Button>
        </Grid>
        <TextBlock Style="{StaticResource FormLabel}" Text="Display name (optional):"/>
        <TextBox x:Name="DisplaynameBox" Style="{StaticResource FormField}" Text=""/>

        <TextBlock Style="{StaticResource FormLabel}" Text="Username (email):"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource FormField}" Text="" TextChanged="UsernameBox_TextChanged"/>
        <TextBlock x:Name="UsernameError" Style="{StaticResource FormError}" Text=""/>

        <TextBlock Style="{StaticResource FormLabel}" Text="Password:"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPassword}" Password="" PasswordChanged="PasswordBox_PasswordChanged"/>
        <TextBlock x:Name="PasswordError" Style="{StaticResource FormError}" Text=""/>

        <TextBlock Style="{StaticResource FormLabel}" Text="Repeat password:"/>
        <PasswordBox x:Name="RepeatPasswordBox" Style="{StaticResource FormPassword}" Password="" PasswordChanged="RepeatPasswordBox_PasswordChanged"/>
        <TextBlock x:Name="RepeatPasswordError" Style="{StaticResource FormError}" Text=""/>

        <Button x:Name="SignupButton" Style="{StaticResource Button}" Content="Sign up" Click="Signup_Click"/>
    </StackPanel>
</Window>
