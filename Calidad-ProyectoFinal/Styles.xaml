<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="DarkSlateBlue"/>
    <SolidColorBrush x:Key="TextBrush" Color="Azure"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="LightGreen"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="Orange"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="LightCoral"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="Transparent"/>

    <Style x:Key="Windows" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="Dialog" TargetType="Window" BasedOn="{StaticResource Windows}">
        <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
    </Style>

    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
        <Setter Property="FontSize" Value="32"/>
    </Style>

    <Style x:Key="FormField" TargetType="TextBox">
        <Setter Property="Width" Value="400"/>
        <Setter Property="Margin" Value="20,0,20,20"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="FormPassword" TargetType="PasswordBox">
        <Setter Property="Width" Value="400"/>
        <Setter Property="Margin" Value="20,0,20,20"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="MaxLength" Value="10"/>
    </Style>

    <Style x:Key="FormError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="20,-14,0,20"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" BorderThickness="4" BorderBrush="{StaticResource ButtonBrush}" Background="{StaticResource ButtonBackgroundBrush}" CornerRadius="20" Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource HighlightBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HighlightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsFocused" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource HighlightBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".25"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource ButtonBrush}"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="Margin" Value="0,10"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="demoButton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    
</ResourceDictionary>