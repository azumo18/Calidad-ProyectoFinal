<Window x:Class="Calidad_ProyectoFinal.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Firebase Auth App" WindowStartupLocation="CenterOwner" Style="{StaticResource Dialog}">
    <StackPanel Margin="40">
        <TextBlock Style="{StaticResource FormLabel}" Text="Username (email):"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource FormField}" Text="azunigamo@ucenfotec.ac.cr"/>

        <TextBlock Style="{StaticResource FormLabel}" Text="Password:"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPassword}" Password="A1234!"/>

        <Button Content="Login" Click="Login_Click"/>

        <Border Height="4" Background="azure" Margin="0,20"/>

        <Button Content="Forgot your password?" Click="ForgotPassword_Click"/>
        <Button Content="Sign-up?" Click="Signup_Click"/>
    </StackPanel>
</Window>