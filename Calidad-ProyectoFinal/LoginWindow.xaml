<Window x:Class="Calidad_ProyectoFinal.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Firebase Auth App" WindowStartupLocation="CenterOwner" Style="{StaticResource Dialog}" Loaded="Window_Loaded" Closing="Window_Closing">
    <StackPanel Margin="40">
        <Grid>
            <TextBlock Text="Login" Style="{StaticResource Title}"/>
            <Button Style="{StaticResource demoButton}" Click="Demo_Click">Demo</Button>
        </Grid>
        <TextBlock Style="{StaticResource FormLabel}" Text="Username (email):"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource FormField}" Text=""/>

        <TextBlock Style="{StaticResource FormLabel}" Text="Password:"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPassword}" Password=""/>

        <Button Style="{StaticResource Button}" Content="Login" Click="Login_Click"/>

        <Border Height="4" Background="azure" Margin="0,20"/>

        <Button Style="{StaticResource Button}" Content="Forgot your password?" Click="ForgotPassword_Click"/>
        <Button Style="{StaticResource Button}" Content="Sign-up?" Click="Signup_Click"/>
    </StackPanel>
</Window>