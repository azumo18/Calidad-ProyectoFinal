<Window x:Class="Calidad_ProyectoFinal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calidad_ProyectoFinal"
        mc:Ignorable="d"
        Title="Firebase Auth App" Height="450" Width="800" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" Style="{StaticResource Windows}">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="userGreeting"  Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="" Style="{StaticResource Title}"/>
        <Button Style="{StaticResource Button}" Grid.Row="1" Content="Log out" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Logout_Click"/>
    </Grid>
</Window>
