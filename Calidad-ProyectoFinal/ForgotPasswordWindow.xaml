<Window x:Class="Calidad_ProyectoFinal.ForgotPasswordWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot your password? - Firebase Auth App" WindowStartupLocation="CenterOwner" Style="{StaticResource Dialog}">
    <StackPanel Margin="40">
        <TextBlock Style="{StaticResource FormLabel}" Text="Username (email):"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource FormField}" Text="azunigamo@ucenfotec.ac.cr" TextChanged="UsernameBox_TextChanged"/>
        <TextBlock x:Name="UsernameError" Style="{StaticResource FormError}" Text=""/>

        <Button x:Name="ResetPasswordButton" Content="Send password reset email" Click="PasswordReset_Click" Width="Auto" Margin="20,0"/>
    </StackPanel>
</Window>